# Hasheem Studio — dedicated self-hosted Supabase + Redis Compose stack.
# This is a NON-SECRET template. Real values live in a generated, protected .env file
# (see scripts/ops/generate-supabase-secrets.mjs) that is never committed — infra/compose/.env
# is gitignored. Ports below are deliberately non-default to avoid colliding with the other
# Supabase stack and other services already running on this shared VPS (see docs/ENVIRONMENTS.md).

# ---- Identity / non-secret config ----
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=55432
POOLER_PROXY_PORT_TRANSACTION=56543
POOLER_TENANT_ID=hasheemstudio
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

API_GW_HTTP_PORT=58000
REDIS_PORT=56379
REDIS_MAXMEMORY=512mb

# Update these once DNS (docs/DECISIONS.md item 1) is live; local/staging placeholders for now.
SUPABASE_PUBLIC_URL=http://127.0.0.1:58000
API_EXTERNAL_URL=http://127.0.0.1:58000/auth/v1
SITE_URL=http://127.0.0.1:5173
ADDITIONAL_REDIRECT_URLS=

JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# Resend SMTP — blocked until docs/DECISIONS.md item 2 (Resend access) resolves.
SMTP_ADMIN_EMAIL=
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_SENDER_NAME=Hasheem Studio

PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

STUDIO_DEFAULT_ORGANIZATION=Hasheem Studio
STUDIO_DEFAULT_PROJECT=Hasheem Studio
OPENAI_API_KEY=

STORAGE_TENANT_ID=hasheemstudio
REGION=local
GLOBAL_S3_BUCKET=hasheemstudio
IMGPROXY_AUTO_WEBP=true
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

DASHBOARD_USERNAME=hasheemstudio-admin

# ---- Secrets (values generated by scripts/ops/generate-supabase-secrets.mjs, never committed) ----
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
REDIS_PASSWORD=
