# Hasheem Studio — non-secret environment template.
# Copy to .env for LOCAL development only. Never commit a filled-in .env.
# Staging/production values live in protected files on the VPS (see docs/ENVIRONMENTS.md),
# never in this repository, chat, or logs.

# --- App ---
NODE_ENV=development
APP_ENV=local
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787

# --- Dedicated self-hosted Supabase (project-scoped, never shared with other products) ---
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_JWT_SECRET=

# --- Redis (dedicated instance, ACL'd, not shared with other projects) ---
REDIS_URL=redis://localhost:6390
REDIS_ACL_USERNAME=
REDIS_ACL_PASSWORD=

# --- Object storage / private media path (see ADR-0003 for the chosen authoritative path) ---
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ENDPOINT=
MEDIA_STORAGE_ACCESS_KEY_ID=
MEDIA_STORAGE_SECRET_ACCESS_KEY=

# --- Resend (Auth SMTP + transactional API) ---
RESEND_API_KEY=
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USERNAME=resend
RESEND_FROM_ADDRESS=Hasheem Studio <noreply@mail.hasheemstudio.com>
RESEND_WEBHOOK_SIGNING_SECRET=

# --- Worker / media processing limits ---
WORKER_MAX_CONCURRENCY_REMUX=1
WORKER_MAX_CONCURRENCY_ENCODE=1
WORKER_SCRATCH_DIR=/tmp/hasheemstudio-scratch
WORKER_MAX_PROBE_SECONDS=30
WORKER_MAX_PROCESS_SECONDS=1800

# --- Admin bootstrap ---
PLATFORM_OWNER_EMAIL=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_METRICS_PORT=9464

# --- CI/deploy identifiers (nonsecret) ---
RELEASE_SHA=
DEPLOY_ENV=
