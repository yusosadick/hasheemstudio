# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
*.tsbuildinfo
.turbo/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
!infra/**/*.example.key
secrets/
**/secrets/

# Supabase local state
supabase/.branches/
supabase/.temp/

# Compose runtime state / secrets — never committed
infra/compose/.env
infra/compose/volumes/db/data/
infra/compose/volumes/storage/
infra/compose/volumes/functions/*
!infra/compose/volumes/functions/.gitkeep
infra/compose/volumes/snippets/*
!infra/compose/volumes/snippets/.gitkeep

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/
playwright-report/
test-results/
.vitest-cache/

# Media fixtures/output must never be committed except tiny licensed test fixtures explicitly reviewed
tests/fixtures/media/*
!tests/fixtures/media/README.md
tmp/
scratch/

# Kubeconfigs and infra local state
kubeconfig*
*.kubeconfig
.terraform/
*.tfstate
*.tfstate.backup

# Evidence must be sanitised before commit — raw capture staging area is ignored
docs/evidence/_raw/
