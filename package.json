{
  "name": "hasheemstudio",
  "private": true,
  "version": "0.0.0",
  "description": "Hasheem Studio monorepo — React/TypeScript frontend, Fastify API, BullMQ media worker, self-hosted Supabase.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "doctor": "node scripts/ops/doctor.mjs",
    "dev:up": "node scripts/ops/not-implemented.mjs dev:up",
    "dev": "node scripts/ops/not-implemented.mjs dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "node scripts/ops/not-implemented.mjs test:unit",
    "test:integration": "node tests/integration/worker-crash-recovery.mjs --fixture tests/fixtures/media/synthetic-remux-test.mov",
    "test:security": "node tests/security/rls.cross-tenant.mjs --env local",
    "test:e2e": "node tests/e2e/upload-to-download.mjs --env local --fixture tests/fixtures/media/synthetic-remux-test.mov",
    "db:local:migrate": "node scripts/ops/not-implemented.mjs db:local:migrate",
    "db:remote": "node scripts/db/remote.mjs",
    "deploy:plan": "node scripts/ops/not-implemented.mjs deploy:plan",
    "deploy": "node scripts/ops/not-implemented.mjs deploy",
    "verify:live": "node scripts/ops/not-implemented.mjs verify:live"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {}
}
