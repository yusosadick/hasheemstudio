{
  "name": "hasheemstudio",
  "private": true,
  "version": "0.0.0",
  "description": "Hasheem Studio monorepo \u2014 React/TypeScript frontend, Fastify API, BullMQ media worker, self-hosted Supabase.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "doctor": "node scripts/ops/doctor.mjs",
    "dev:up": "node scripts/ops/dev-up.mjs",
    "dev": "node scripts/ops/dev.mjs",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm test && python3 tests/security/google_oauth_provisioning_test.py",
    "test:integration": "pnpm test:integration:crash-recovery && pnpm test:integration:quota-race && pnpm test:integration:retention && pnpm test:integration:hostile-inputs && pnpm test:integration:account-deletion && pnpm test:integration:backup-restore",
    "test:integration:account-deletion": "node tests/integration/account-deletion.mjs --env local",
    "test:integration:backup-restore": "node tests/integration/backup-restore-rehearsal.mjs --env local",
    "test:integration:crash-recovery": "node tests/integration/worker-crash-recovery.mjs --fixture tests/fixtures/media/synthetic-remux-test.mov",
    "test:integration:quota-race": "node tests/integration/quota-race.mjs --env local",
    "test:integration:retention": "node tests/integration/retention-sweep.mjs --env local",
    "test:integration:hostile-inputs": "node tests/integration/hostile-media-inputs.mjs --env local",
    "test:security": "node tests/security/rls.cross-tenant.mjs --env local",
    "test:guest-download": "node tests/integration/guest-download-gate.mjs",
    "test:guest-browser": "node tests/e2e/guest-auth-browser.mjs",
    "test:e2e": "pnpm test:e2e:upload && pnpm test:e2e:compat-encode && pnpm test:e2e:resumable",
    "test:e2e:upload": "node tests/e2e/upload-to-download.mjs --env local --fixture tests/fixtures/media/synthetic-remux-test.mov",
    "test:e2e:compat-encode": "node tests/e2e/compat-encode.mjs --env local",
    "test:e2e:resumable": "node tests/e2e/resumable-upload-interruption.mjs --env local",
    "test:e2e:browser": "node tests/e2e/browser-upload-to-download.mjs --env local",
    "ops:retention-sweep": "node scripts/ops/retention-sweep.mjs --env local",
    "ops:backup-db": "node scripts/ops/backup-db.mjs --env local",
    "test:a11y": "node tests/e2e/accessibility.mjs",
    "test:load:api": "node tests/load/api-latency.mjs --env local",
    "test:load:queue": "node tests/load/queue-throughput.mjs --env local",
    "db:local:migrate": "node scripts/ops/db-local-migrate.mjs",
    "db:remote": "node scripts/db/remote.mjs",
    "deploy:plan": "node scripts/ops/not-implemented.mjs deploy:plan",
    "deploy": "node scripts/ops/not-implemented.mjs deploy",
    "verify:live": "node scripts/ops/not-implemented.mjs verify:live",
    "test:limits": "pnpm --filter @hasheemstudio/api exec node --import tsx ../../tests/integration/free-limit-and-retention.mjs",
    "test:payments": "pnpm --filter @hasheemstudio/api exec node --import tsx ../../tests/integration/studio-payments.mjs",
    "test:auth-codes": "node tests/integration/auth-email-codes.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright": "^1.63.0"
  }
}
